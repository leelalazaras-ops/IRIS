# IRIS Environment Configuration
# Copy this file to .env and fill in your values

# Application Settings
IRIS_ENV=development
IRIS_DEBUG=true
IRIS_LOG_LEVEL=INFO

# AI Provider Configuration
# Provider type: "openai-compatible" or "mock"
IRIS_AI_PROVIDER=openai-compatible

# Base URL for OpenAI-compatible API (required for openai-compatible provider)
# Examples:
#   OpenAI: https://api.openai.com/v1
#   OmniRoute: https://omniroute.example.com/v1
IRIS_AI_BASE_URL=https://api.openai.com/v1

# API Key (required for openai-compatible provider, DO NOT commit real keys)
IRIS_AI_API_KEY=your_api_key_here

# Model identifier
IRIS_AI_MODEL=gpt-3.5-turbo

# Request timeout in seconds
IRIS_AI_TIMEOUT=30.0

# Voice Settings
# VOICE_ENABLED=false
# TTS_PROVIDER=
# STT_PROVIDER=

# Vision Settings
# VISION_ENABLED=false

# Memory Settings
# MEMORY_BACKEND=local
# MEMORY_PATH=./data/memory

# Web Settings
# WEB_HOST=localhost
# WEB_PORT=8000

# Security Settings
# SECRET_KEY=generate_a_secure_random_key_here
# ALLOWED_HOSTS=localhost,127.0.0.1
